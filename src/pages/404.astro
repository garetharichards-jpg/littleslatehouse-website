---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found — Little Slate House"
  description="The page you're looking for doesn't exist."
>
  <div class="min-h-[60vh] flex items-center justify-center px-4 py-20">
    <div class="text-center max-w-md">
      <p class="text-slate-500 text-7xl font-bold mb-4">404</p>
      <h1 class="text-2xl font-bold text-stone-900 mb-3">Page not found</h1>
      <p class="text-stone-600 mb-8">
        This path doesn't lead anywhere — a bit like taking a wrong turn on Skiddaw.
        Head back to the house.
      </p>
      <a
        href="/"
        class="inline-flex items-center px-6 py-3 bg-slate-700 text-white font-semibold rounded-md hover:bg-slate-600 transition-colors focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2"
      >
        Back to Little Slate House
      </a>
    </div>
  </div>
</Layout>
