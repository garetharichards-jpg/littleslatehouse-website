---
// Webhook URL — configure before go-live.
// See BUILD-REPORT.md for instructions on setting up the n8n webhook.
// For preview (tailnet only): set to https://gs-mac-mini.tail54a913.ts.net:5678/webhook/little-slate-house-enquiry
// after importing and activating n8n-workflows/website-enquiry-handler.json in n8n.
// For production: set to the public n8n webhook URL (via Cloudflare Tunnel) or a form service endpoint.
const WEBHOOK_URL = 'PLACEHOLDER_N8N_WEBHOOK_URL';

interface Props {
  // Pass the WhatsApp number (digits only) and default message from the page.
  // If omitted or placeholder, the "Send via WhatsApp instead" button is hidden.
  whatsappNumber?: string;
  whatsappDefaultMessage?: string;
}

const {
  whatsappNumber = '',
  whatsappDefaultMessage = '',
} = Astro.props;

const waActive = !!whatsappNumber && whatsappNumber !== '__WHATSAPP_NUMBER__';
---

<div class="bg-white rounded-xl shadow-sm border border-stone-200 p-6 sm:p-8">
  <h2 class="text-2xl font-semibold text-stone-900 mb-2">Send an enquiry</h2>
  <p class="text-stone-600 mb-6 text-sm">
    Tell us your dates and party size and we'll come back to you with availability and rates.
  </p>

  <form
    id="enquiry-form"
    data-webhook={WEBHOOK_URL}
    class="space-y-5"
    novalidate
  >
    <!-- Name -->
    <div>
      <label for="name" class="block text-sm font-medium text-stone-700 mb-1">
        Your name <span class="text-red-500" aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        autocomplete="name"
        class="w-full px-3 py-2 border border-stone-300 rounded-md text-sm text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
        placeholder="Jane Smith"
      />
    </div>

    <!-- Email -->
    <div>
      <label for="email" class="block text-sm font-medium text-stone-700 mb-1">
        Email address <span class="text-red-500" aria-hidden="true">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        autocomplete="email"
        class="w-full px-3 py-2 border border-stone-300 rounded-md text-sm text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
        placeholder="jane@example.com"
      />
    </div>

    <!-- Dates row -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="arrival" class="block text-sm font-medium text-stone-700 mb-1">
          Arrival date <span class="text-red-500" aria-hidden="true">*</span>
        </label>
        <input
          type="date"
          id="arrival"
          name="arrival"
          required
          class="w-full px-3 py-2 border border-stone-300 rounded-md text-sm text-stone-900 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
        />
      </div>
      <div>
        <label for="departure" class="block text-sm font-medium text-stone-700 mb-1">
          Departure date <span class="text-red-500" aria-hidden="true">*</span>
        </label>
        <input
          type="date"
          id="departure"
          name="departure"
          required
          class="w-full px-3 py-2 border border-stone-300 rounded-md text-sm text-stone-900 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500"
        />
      </div>
    </div>

    <!-- Party size -->
    <div>
      <label for="party-size" class="block text-sm font-medium text-stone-700 mb-1">
        Party size <span class="text-red-500" aria-hidden="true">*</span>
      </label>
      <select
        id="party-size"
        name="partySize"
        required
        class="w-full px-3 py-2 border border-stone-300 rounded-md text-sm text-stone-900 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500 bg-white"
      >
        <option value="">Select…</option>
        <option value="1">1 guest</option>
        <option value="2">2 guests</option>
        <option value="3">3 guests</option>
        <option value="4">4 guests</option>
        <option value="5">5 guests</option>
        <option value="6">6 guests (maximum)</option>
      </select>
    </div>

    <!-- Message -->
    <div>
      <label for="message" class="block text-sm font-medium text-stone-700 mb-1">
        Anything else we should know?
      </label>
      <textarea
        id="message"
        name="message"
        rows="4"
        class="w-full px-3 py-2 border border-stone-300 rounded-md text-sm text-stone-900 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:border-slate-500 resize-y"
        placeholder="Any questions about the house, the area, or your stay — just ask."
      ></textarea>
    </div>

    <!-- Honeypot (bot trap) -->
    <div class="hidden" aria-hidden="true">
      <label for="website">Leave this blank</label>
      <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Error message -->
    <div
      id="form-error"
      class="hidden p-3 bg-red-50 border border-red-200 rounded-md text-sm text-red-700"
      role="alert"
    >
    </div>

    <!-- Submit + optional WhatsApp secondary action -->
    <div class="flex flex-col sm:flex-row sm:items-center gap-3 pt-1">
      <button
        type="submit"
        id="submit-btn"
        class="w-full sm:w-auto px-6 py-3 bg-slate-700 text-white text-sm font-medium rounded-md hover:bg-slate-600 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 transition-colors disabled:opacity-60 disabled:cursor-not-allowed"
      >
        Send enquiry
      </button>

      {waActive && (
        <>
          <span class="hidden sm:block text-stone-300 text-sm select-none" aria-hidden="true">or</span>
          <button
            type="button"
            id="wa-form-btn"
            data-wa-number={whatsappNumber}
            data-wa-default={whatsappDefaultMessage}
            aria-label="Send your enquiry details via WhatsApp instead (opens WhatsApp)"
            class="inline-flex items-center justify-center gap-2 px-5 py-3 border border-stone-300 bg-white text-stone-700 text-sm font-medium rounded-md hover:bg-stone-50 hover:border-stone-400 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 transition-colors"
          >
            <svg class="h-4 w-4 flex-shrink-0 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Send via WhatsApp instead
          </button>
        </>
      )}
    </div>
  </form>

  <!-- Success state -->
  <div
    id="form-success"
    class="hidden p-6 bg-green-50 border border-green-200 rounded-lg text-center"
    role="status"
  >
    <svg class="mx-auto mb-3 h-10 w-10 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <h3 class="text-lg font-semibold text-green-900 mb-1">Enquiry received</h3>
    <p class="text-sm text-green-700">We'll be in touch within 24 hours to confirm availability and rates.</p>
  </div>
</div>

<script>
  // ── WhatsApp "Send via WhatsApp instead" button ──────────────────────────
  // Reads whatever the guest has typed so far, builds a pre-filled message,
  // and opens wa.me in a new tab. Pure client-side — no backend involved.
  const waBtn = document.getElementById('wa-form-btn') as HTMLButtonElement | null;

  waBtn?.addEventListener('click', () => {
    const number = waBtn.dataset.waNumber ?? '';
    const defaultMsg = waBtn.dataset.waDefault ?? '';

    const name     = (document.getElementById('name')       as HTMLInputElement | null)?.value.trim();
    const arrival  = (document.getElementById('arrival')    as HTMLInputElement | null)?.value;
    const departure = (document.getElementById('departure') as HTMLInputElement | null)?.value;
    const partySize = (document.getElementById('party-size') as HTMLSelectElement | null)?.value;
    const message  = (document.getElementById('message')    as HTMLTextAreaElement | null)?.value.trim();

    // Build a human-readable message from whatever fields are filled.
    // Fall back to the default message if nothing has been typed yet.
    let text = defaultMsg;
    if (name || arrival || departure || partySize || message) {
      const lines = ["Hi Little Slate House — I'd like to enquire about staying."];
      if (arrival && departure) lines.push(`\nDates: ${arrival} to ${departure}`);
      else if (arrival)         lines.push(`\nArrival: ${arrival}`);
      if (partySize)            lines.push(`Party size: ${partySize}`);
      if (name)                 lines.push(`Name: ${name}`);
      if (message)              lines.push(`\n${message}`);
      text = lines.join('\n');
    }

    const url = `https://wa.me/${number}?text=${encodeURIComponent(text)}`;
    window.open(url, '_blank', 'noopener,noreferrer');
  });

  // ── Main form submit (email/n8n path) ────────────────────────────────────
  const form = document.getElementById('enquiry-form') as HTMLFormElement | null;
  const successDiv = document.getElementById('form-success');
  const errorDiv = document.getElementById('form-error');
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !submitBtn) return;

    // Honeypot check
    const honeypot = (form.elements.namedItem('website') as HTMLInputElement)?.value;
    if (honeypot) return; // silently reject bots

    // Basic validation
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const webhookUrl = form.dataset.webhook ?? '';

    if (!webhookUrl || webhookUrl === 'PLACEHOLDER_N8N_WEBHOOK_URL') {
      if (errorDiv) {
        errorDiv.textContent = 'The enquiry form is not yet connected — please contact us via Instagram @littleslatehouse.';
        errorDiv.classList.remove('hidden');
      }
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = 'Sending…';
    if (errorDiv) errorDiv.classList.add('hidden');

    const data = Object.fromEntries(new FormData(form));

    try {
      const res = await fetch(webhookUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok || res.status === 200) {
        form.classList.add('hidden');
        successDiv?.classList.remove('hidden');
      } else {
        throw new Error(`HTTP ${res.status}`);
      }
    } catch {
      if (errorDiv) {
        errorDiv.textContent =
          'Something went wrong sending your enquiry. Please try again or contact us on Instagram @littleslatehouse.';
        errorDiv.classList.remove('hidden');
      }
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send enquiry';
    }
  });
</script>
