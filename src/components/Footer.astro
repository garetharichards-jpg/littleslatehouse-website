---
import WhatsAppButton from './WhatsAppButton.astro';
import { property } from '../data/house.ts';

const year = new Date().getFullYear();
---

<footer class="bg-stone-900 text-stone-300 mt-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
      <!-- Brand col -->
      <div>
        <h2 class="text-white font-semibold text-lg mb-3">Little Slate House</h2>
        <p class="text-sm leading-relaxed text-stone-400">
          A three-bedroom Victorian cottage in Keswick town centre, Lake District.
          Sleeps 6. Two minutes from the high street, one from Fitz Park.
        </p>
      </div>

      <!-- Nav col -->
      <div>
        <h3 class="text-white text-sm font-semibold uppercase tracking-wider mb-3">Explore</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
          <li><a href="/the-house/" class="hover:text-white transition-colors">The House</a></li>
          <li><a href="/keswick/" class="hover:text-white transition-colors">Keswick &amp; the Area</a></li>
          <li><a href="/gallery/" class="hover:text-white transition-colors">Gallery</a></li>
          <li><a href="/availability/" class="hover:text-white transition-colors">Availability &amp; Enquiry</a></li>
        </ul>
      </div>

      <!-- Contact col -->
      <div>
        <h3 class="text-white text-sm font-semibold uppercase tracking-wider mb-3">Find us</h3>
        <address class="not-italic text-sm text-stone-400 space-y-2">
          <p>Keswick, Cumbria, England</p>
          <p>
            Instagram:
            <a
              href="https://www.instagram.com/littleslatehouse"
              class="text-stone-300 hover:text-white transition-colors"
              rel="noopener noreferrer"
              target="_blank"
            >
              @littleslatehouse
            </a>
          </p>
          <p>
            Facebook:
            <a
              href="https://www.facebook.com/littleslatehouse"
              class="text-stone-300 hover:text-white transition-colors"
              rel="noopener noreferrer"
              target="_blank"
            >
              Little Slate House
            </a>
          </p>
          <p>
            <WhatsAppButton
              number={property.whatsappNumber}
              message={property.whatsappDefaultMessage}
              label="WhatsApp"
              variant="footer"
            />
          </p>
          <p class="pt-2">
            <a
              href="/availability/"
              class="inline-block px-4 py-2 bg-slate-600 text-white text-sm font-medium rounded-md hover:bg-slate-500 transition-colors"
            >
              Enquire about dates
            </a>
          </p>
        </address>
      </div>
    </div>

    <div class="mt-10 pt-6 border-t border-stone-700 text-center text-xs text-stone-500">
      <p>
        &copy; {year} Little Slate House. All rights reserved.
        &nbsp;·&nbsp;
        Keswick, Cumbria
      </p>
    </div>
  </div>
</footer>
