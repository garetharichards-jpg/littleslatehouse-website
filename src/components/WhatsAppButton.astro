---
/**
 * WhatsAppButton — wa.me click-to-chat only. No Cloud API, no backend.
 *
 * Variants:
 *   'default'  — slate-bordered inline button, for sidebar / standalone use
 *   'footer'   — text link style for use on the dark footer background
 *   'floating' — fixed-position pill, rendered once in Layout
 *
 * If `number` is the placeholder string, the component renders nothing so the
 * page stays clean until the real number is configured in src/data/house.ts.
 */

interface Props {
  number: string;          // digits only, e.g. 447700900000
  message: string;         // pre-filled text (unencoded)
  label?: string;
  variant?: 'default' | 'footer' | 'floating';
}

const {
  number,
  message,
  label = 'Message us on WhatsApp',
  variant = 'default',
} = Astro.props;

const isPlaceholder = !number || number === '__WHATSAPP_NUMBER__';
if (isPlaceholder) return; // render nothing until the real number is set

const href = `https://wa.me/${number}?text=${encodeURIComponent(message)}`;

// Shared WhatsApp SVG path
const waPath = "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z";
---

{variant === 'default' && (
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${label} (opens WhatsApp)`}
    class="inline-flex items-center gap-2 px-4 py-2.5 border border-stone-300 bg-white text-stone-700 text-sm font-medium rounded-md hover:bg-stone-50 hover:border-stone-400 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 transition-colors"
  >
    <svg class="h-6 w-6 flex-shrink-0 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d={waPath} />
    </svg>
    {label}
  </a>
)}

{variant === 'footer' && (
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`${label} (opens WhatsApp)`}
    class="inline-flex items-center gap-2 text-stone-300 hover:text-white transition-colors"
  >
    <svg class="h-6 w-6 flex-shrink-0 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d={waPath} />
    </svg>
    WhatsApp
  </a>
)}

{variant === 'floating' && (
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Message Little Slate House on WhatsApp"
    class="fixed bottom-6 right-6 z-40 inline-flex items-center gap-2 px-3.5 py-2 bg-stone-800 text-white text-xs font-medium rounded-full shadow-lg hover:bg-stone-700 focus:outline-none focus:ring-2 focus:ring-stone-600 focus:ring-offset-2 transition-colors"
  >
    <svg class="h-6 w-6 flex-shrink-0 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d={waPath} />
    </svg>
    WhatsApp
  </a>
)}
